{
  "version": 2,
  "installCommand": "cd dashboard && npm install",
  "buildCommand": "cd dashboard && CI=false npm run build",
  "outputDirectory": "dashboard/build",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "REACT_APP_API_URL": "https://moil-mining-backend.onrender.com"
  }
}
